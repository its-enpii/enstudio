{
  "name": "enpiistudio",
  "private": true,
  "version": "0.1.1",
  "description": "Personal agentic coding workspace — enpii on your own endpoint",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @enstudio/desktop",
    "dev:devtools": "npm run dev:devtools -w @enstudio/desktop",
    "build": "run-s -x build:agent build:desktop",
    "dev:agent": "npm run dev -w @enstudio/agent-core",
    "typecheck": "run-s -x typecheck:agent typecheck:desktop",
    "test": "npm run test -w @enstudio/agent-core",
    "typecheck:agent": "npm run typecheck -w @enstudio/agent-core",
    "typecheck:desktop": "npm run typecheck -w @enstudio/desktop",
    "pack:check": "run-s -x build typecheck test",
    "build:agent": "npm run build -w @enstudio/agent-core",
    "build:desktop": "npm run build -w @enstudio/desktop",
    "pack": "npm run pack -w @enstudio/desktop",
    "dist": "npm run dist -w @enstudio/desktop",
    "dist:linux": "npm run dist:linux -w @enstudio/desktop",
    "dist:win": "npm run dist:win -w @enstudio/desktop",
    "dist:mac": "npm run dist:mac -w @enstudio/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "npm-run-all2": "^9.0.3"
  }
}
