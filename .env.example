# Optional overrides for enpii provider (also: ~/.enpiistudio/config.toml; legacy config.json still loads)
ENPII_BASE_URL=https://ai.enpiistudio.com/v1
ENPII_API_KEY=
ENPII_MODEL=enpii
ENPII_DIALECT=openai

# Optional web tools (web_fetch / web_search) — public hosts only; SSRF-blocked private ranges
# ENPII_WEB_SEARCH_URL=https://html.duckduckgo.com/html/
# ENPII_WEB_PROXY=http://127.0.0.1:7890
