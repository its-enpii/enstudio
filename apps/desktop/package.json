{
  "name": "@enpiistudio/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:devtools": "node ./scripts/dev-devtools.mjs",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "preview": "vite preview",
    "pack": "npm run build -w @enpiistudio/agent-core && vite build && electron-builder --dir",
    "dist": "npm run build -w @enpiistudio/agent-core && vite build && electron-builder",
    "dist:dir": "npm run pack",
    "dist:linux": "npm run build -w @enpiistudio/agent-core && vite build && electron-builder --linux",
    "dist:win": "npm run build -w @enpiistudio/agent-core && vite build && electron-builder --win",
    "dist:mac": "npm run build -w @enpiistudio/agent-core && vite build && electron-builder --mac"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@enpiistudio/agent-core": "0.1.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.10",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "studio.enpii.app",
    "productName": "enpiistudio",
    "copyright": "Copyright © enpii",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/agent-core/dist",
        "to": "agent-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "enpii"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
