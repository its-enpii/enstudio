{
  "name": "@enstudio/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Personal agentic coding workspace \u00e2\u20ac\u201d enpii on your own endpoint",
  "author": {
    "name": "enpii",
    "email": "noreply@enpii.studio"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node ./scripts/dev-all.mjs",
    "dev:devtools": "node ./scripts/dev-devtools.mjs",
    "predev": "node ./scripts/build-electron-extras.mjs",
    "build": "node ./scripts/build.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "preview": "vite preview",
    "prepack": "node ./scripts/build.mjs",
    "pack": "electron-builder --dir",
    "predist": "node ./scripts/build.mjs",
    "dist": "electron-builder",
    "predist:dir": "node ./scripts/build.mjs",
    "dist:dir": "electron-builder --dir",
    "predist:linux": "node ./scripts/build.mjs",
    "dist:linux": "electron-builder --linux",
    "predist:win": "node ./scripts/build.mjs",
    "dist:win": "electron-builder --win",
    "predist:mac": "node ./scripts/build.mjs",
    "dist:mac": "electron-builder --mac",
    "dev:vite": "vite",
    "dev:electron": "node ./scripts/dev-electron.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@enstudio/agent-core": "0.1.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.10",
    "electron": "35.7.5",
    "electron-builder": "^26.15.3",
    "svelte": "^5.20.5",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "studio.enpii.app",
    "productName": "EnStudio",
    "copyright": "Copyright \u00c2\u00a9 enpii",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../packages/agent-core/dist",
        "to": "agent-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "its-enpii",
      "repo": "enstudio"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "enpii"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}